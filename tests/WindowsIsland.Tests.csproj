<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>WindowsIsland.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The pure logic is compiled straight from the app, so the tests need no window and no Windows services -->
  <ItemGroup>
    <Compile Include="..\src\ClaudeWaiting.cs" Link="App\ClaudeWaiting.cs" />
    <Compile Include="..\src\ClaudeHook.cs" Link="App\ClaudeHook.cs" />
    <Compile Include="..\src\LimitMath.cs" Link="App\LimitMath.cs" />
    <Compile Include="..\src\DayStats.cs" Link="App\DayStats.cs" />
    <Compile Include="..\src\DiscordRpc.cs" Link="App\DiscordRpc.cs" />
    <Compile Include="..\src\SteamManifest.cs" Link="App\SteamManifest.cs" />
    <Compile Include="..\src\ObsLog.cs" Link="App\ObsLog.cs" />
    <Compile Include="..\src\FootballFeed.cs" Link="App\FootballFeed.cs" />
    <Compile Include="..\src\ClipboardHistory.cs" Link="App\ClipboardHistory.cs" />
    <Compile Include="..\src\ReminderParser.cs" Link="App\ReminderParser.cs" />
    <Compile Include="..\src\ReminderStore.cs" Link="App\ReminderStore.cs" />
    <Compile Include="..\src\DownloadRules.cs" Link="App\DownloadRules.cs" />
    <Compile Include="..\src\IslandRules.cs" Link="App\IslandRules.cs" />
  </ItemGroup>

</Project>
