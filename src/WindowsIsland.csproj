<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WindowsIsland</RootNamespace>
    <AssemblyName>WindowsIsland</AssemblyName>
    <Product>Windows Island</Product>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.8.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- A small always-on overlay: favor a low memory footprint over GC throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\thinking.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\codex.png" />
    <Resource Include="Assets\claude-mark.png" />
    <Resource Include="Assets\codex-mark.png" />
    <Resource Include="Assets\fonts\*.ttf" />
  </ItemGroup>

  <!-- The browser extension travels inside the exe; Settings unpacks it for the user -->
  <ItemGroup>
    <EmbeddedResource Include="..\extension\manifest.json;..\extension\background.js;..\extension\options.html;..\extension\options.js" LogicalName="extension/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
