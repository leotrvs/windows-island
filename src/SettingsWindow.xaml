<Window x:Class="WindowsIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="420" Height="600" MinWidth="380" MinHeight="360"
        WindowStartupLocation="Manual" ResizeMode="CanResize" Icon="Assets/app.ico" WindowStyle="None"
        Background="#FF000000" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextRenderingMode="Auto" TextOptions.TextFormattingMode="Ideal" RenderOptions.ClearTypeHint="Enabled" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#FF1C1C1E"/>
        <SolidColorBrush x:Key="Separator" Color="#FF38383A"/>
        <SolidColorBrush x:Key="Secondary" Color="#FF8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="On" Color="#FF30D158"/>
        <SolidColorBrush x:Key="Off" Color="#FF39393D"/>
        <SolidColorBrush x:Key="ChipHover" Color="#FF636366"/>
        <SolidColorBrush x:Key="SliderTrack" Color="#FF3A3A3C"/>
        <SolidColorBrush x:Key="Thumb" Color="#40FFFFFF"/>

        <!-- iOS-style switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Colors and knob position are set from code: at once on load, animated on a click -->
                        <Border x:Name="Track" Width="38" Height="23" CornerRadius="11.5" Background="#FF39393D">
                            <Ellipse x:Name="Knob" Width="19" Height="19" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3"/></Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control item -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="7" Background="Transparent" Padding="8,5" Margin="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ChipHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource SliderTrack}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="20" Height="20" Fill="White">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text button, iOS blue -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A scrollbar that stays out of the way: thin, rounded, no arrows -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="{StaticResource Thumb}" Margin="0,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20,12,14,6">
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="Heading" FontSize="24" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="CloseButton" Width="30" Height="30" CornerRadius="15" Background="Transparent" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#FF8E8E93" StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <ContentControl x:Name="TabBar"/>
            <Border Margin="0,10,0,0" CornerRadius="9" Background="{DynamicResource Card}" Padding="12,0" Height="32">
                <Grid>
                    <TextBlock x:Name="SearchHint" Foreground="{DynamicResource Secondary}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                             CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Content" Margin="20,0,16,22"/>
        </ScrollViewer>
    </Grid>
</Window>
