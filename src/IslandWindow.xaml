<Window x:Class="WindowsIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsIsland"
        Title="Windows Island" Width="520" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#FF98989F"/>
        <SolidColorBrush x:Key="Track" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ClaudeOrange" Color="#FFE8875F"/>

        <Geometry x:Key="PlayGlyph">M 2,1.6 C 2,0.4 3.3,-0.3 4.3,0.3 L 16.6,7.8 C 17.6,8.4 17.6,9.6 16.6,10.2 L 4.3,17.7 C 3.3,18.3 2,17.6 2,16.4 Z</Geometry>
        <Geometry x:Key="PauseGlyph">M 1.6,0 H 4.9 Q 6.5,0 6.5,1.6 V 16.4 Q 6.5,18 4.9,18 H 1.6 Q 0,18 0,16.4 V 1.6 Q 0,0 1.6,0 Z M 12.1,0 H 15.4 Q 17,0 17,1.6 V 16.4 Q 17,18 15.4,18 H 12.1 Q 10.5,18 10.5,16.4 V 1.6 Q 10.5,0 12.1,0 Z</Geometry>
        <Geometry x:Key="SkipGlyph">M 0,1.3 C 0,0.3 1.1,-0.3 1.9,0.3 L 10,6.1 C 10.7,6.6 10.7,7.4 10,7.9 L 1.9,13.7 C 1.1,14.3 0,13.7 0,12.7 Z M 10.6,1.3 C 10.6,0.3 11.7,-0.3 12.5,0.3 L 20.6,6.1 C 21.3,6.6 21.3,7.4 20.6,7.9 L 12.5,13.7 C 11.7,14.3 10.6,13.7 10.6,12.7 Z</Geometry>

        <SolidColorBrush x:Key="CodexBlue" Color="#FF8AB4FF"/>
        <Geometry x:Key="CodexGlyph">M 1,1 L 6,6 L 1,11 M 8.5,11 H 15</Geometry>
        <Style x:Key="CodexMark" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource CodexGlyph}"/>
            <Setter Property="Stroke" Value="{StaticResource CodexBlue}"/>
            <Setter Property="StrokeThickness" Value="2.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Geometry x:Key="BellGlyph">M 12,2 C 8.1,2 6,4.9 6,8.5 V 13 L 4,16 V 17 H 20 V 16 L 18,13 V 8.5 C 18,4.9 15.9,2 12,2 Z M 9.5,18.5 C 9.8,20 10.8,21 12,21 C 13.2,21 14.2,20 14.5,18.5 Z</Geometry>

        <LinearGradientBrush x:Key="ArtPlaceholder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF48484A" Offset="0"/>
            <GradientStop Color="#FF1C1C1E" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ControlButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style x:Key="ClockMark" TargetType="Path">
            <Setter Property="Data" Value="M7,1 A6,6 0 1 1 6.99,1 Z M7,4 L7,7.5 L9.5,9"/>
            <Setter Property="Stroke" Value="#FF9F0A"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Second activity, split off to the right of the island like on iOS -->
        <Border x:Name="Bubble" Width="34" Height="34" CornerRadius="17" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0"
                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.4" ScaleY="0.4"/>
                    <TranslateTransform x:Name="BubbleShift"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <local:ClaudeSpark x:Name="BubbleSpark" Width="20" Height="20"/>
                <Ellipse x:Name="BubbleArt" Width="22" Height="22" Visibility="Collapsed"/>
                <Image x:Name="BubbleCodex" Source="Assets/codex.png" Width="20" Height="20" Visibility="Collapsed"/>
                <Path x:Name="BubbleTimer" Style="{StaticResource ClockMark}" Width="16" Height="16" Visibility="Collapsed"/>
                <Grid x:Name="BubbleExternalGroup" Visibility="Collapsed">
                    <Ellipse x:Name="BubbleRingTrack" Width="28" Height="28" Stroke="#33FFFFFF" StrokeThickness="2.5" Visibility="Collapsed"/>
                    <Path x:Name="BubbleRing" Stroke="#0A84FF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="BubbleExternal" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#0A84FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid x:Name="BubbleDone" Width="26" Height="26" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BubbleDoneScale"/></Grid.RenderTransform>
                        <Ellipse Fill="#30D158"/>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="BubbleBattery" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE83E;" FontSize="16" Foreground="#30D158"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Microphone and camera in use, split off to the left of the island -->
        <Border x:Name="PrivacyDots" Width="30" Height="17" CornerRadius="8.5" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="PrivacyShift"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#E0922A" Margin="2.5,0"/>
                <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="#3FBF5F" Margin="2.5,0"/>
                <Ellipse x:Name="ScreenDot" Width="6" Height="6" Fill="#3B8CFF" Margin="2.5,0"/>
                <!-- Muted or deafened in Discord: a crossed microphone or crossed headphones -->
                <Grid x:Name="DiscordMute" Width="11" Height="11" Margin="3,0" Visibility="Collapsed">
                    <Path Stroke="#FFFF453A" StrokeThickness="1.1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5.5,0.6 A1.7,1.7 0 0 1 7.2,2.3 L7.2,5 A1.7,1.7 0 0 1 3.8,5 L3.8,2.3 A1.7,1.7 0 0 1 5.5,0.6 Z M2,4.6 A3.5,3.5 0 0 0 9,4.6 M5.5,8.1 L5.5,10"/>
                    <Path Stroke="#FFFF453A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L10,10"/>
                </Grid>
                <Grid x:Name="DiscordDeaf" Width="11" Height="11" Margin="3,0" Visibility="Collapsed">
                    <Path Stroke="#FFFF453A" StrokeThickness="1.1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1.6,7 L1.6,5.6 A3.9,3.9 0 0 1 9.4,5.6 L9.4,7 M1.1,6.4 L2.9,6.4 L2.9,9.2 L1.1,9.2 Z M8.1,6.4 L9.9,6.4 L9.9,9.2 L8.1,9.2 Z"/>
                    <Path Stroke="#FFFF453A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L10,10"/>
                </Grid>
                <TextBlock x:Name="PrivacyName" FontSize="10.5" Foreground="#D9FFFFFF" Margin="3,0,6,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border x:Name="Pill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="112" Height="30" CornerRadius="15" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="0.7" ScaleY="0.7"/></Border.RenderTransform>

            <Canvas x:Name="Stage">
                <Grid x:Name="IdlePanel" Width="112" Height="30">
                    <TextBlock x:Name="FocusMoon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE708;" FontSize="12" Foreground="#A78BFA"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- The thin line: a tiny icon of what is happening and a rail that fills -->
                <Grid x:Name="MinimalPanel" Width="76" Height="16">
                    <Border x:Name="MinimalBase" Height="6" VerticalAlignment="Top" CornerRadius="3" Opacity="0"/>
                    <Border x:Name="MinimalTrack" Height="6" VerticalAlignment="Top" CornerRadius="3" Background="#26FFFFFF" Visibility="Collapsed">
                        <Border x:Name="MinimalFill" HorizontalAlignment="Left" CornerRadius="3" Width="0" Background="White"/>
                    </Border>
                    <StackPanel x:Name="MinimalBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Height="6" Visibility="Collapsed"/>
                    <TextBlock x:Name="MinimalGlyph" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Collapsed"/>
                </Grid>

                <!-- A change in the music (pause, play, next, previous) while the island is a thin line -->
                <Grid x:Name="MusicPeek" Width="236" Height="36">
                    <Border x:Name="PeekArt" Width="24" Height="24" CornerRadius="6" HorizontalAlignment="Left" Margin="8,0,0,0"
                            Background="{StaticResource ArtPlaceholder}"/>
                    <TextBlock x:Name="PeekTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="42,0,40,0"/>
                    <TextBlock x:Name="PeekGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <!-- Music, compact -->
                <Grid x:Name="MusicCompact" Width="176" Height="34">
                    <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                            Margin="7,0,0,0" Background="{StaticResource ArtPlaceholder}"/>
                    <Canvas x:Name="CompactEq" Width="20" Height="14" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                </Grid>

                <!-- Claude, compact -->
                <Grid x:Name="ClaudeCompact" Width="176" Height="34">
                    <local:ClaudeSpark x:Name="CompactSpark" Width="20" Height="20" HorizontalAlignment="Left" Margin="9,0,0,0"/>
                    <TextBlock x:Name="ClaudeCompactText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Codex, compact -->
                <Grid x:Name="CodexCompact" Width="176" Height="34">
                    <Image x:Name="CodexCompactGlyph" Source="Assets/codex.png" Width="22" Height="22"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="CodexCompactText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Processor and memory, compact: rings, bars or numbers -->
                <Grid x:Name="SystemCompact" Width="140" Height="34">
                    <StackPanel x:Name="SysRings" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="3"/>
                            <Path x:Name="SysCpuRing" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock x:Name="SysCpuRingText" Width="28" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        <Grid Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Ellipse Stroke="#33FFFFFF" StrokeThickness="3"/>
                            <Path x:Name="SysMemRing" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock x:Name="SysMemRingText" Width="28" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <StackPanel x:Name="SysBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="CPU" FontSize="11" FontWeight="Medium" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <Border Width="42" Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="SysCpuBar" HorizontalAlignment="Left" CornerRadius="2.5" Width="0"/>
                        </Border>
                        <TextBlock Text="RAM" FontSize="11" FontWeight="Medium" Foreground="#8E8E93" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Border Width="42" Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="SysMemBar" HorizontalAlignment="Left" CornerRadius="2.5" Width="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="SysNumbers" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="CPU" FontSize="11" FontWeight="Medium" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SysCpuNumber" Width="34" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="RAM" FontSize="11" FontWeight="Medium" Foreground="#8E8E93" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SysMemNumber" Width="34" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>

                <!-- Battery charging, compact -->
                <Grid x:Name="BatteryCompact" Width="150" Height="34">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE83E;" FontSize="16" Foreground="#30D158"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
                    <TextBlock x:Name="BatteryCompactText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" FontSize="13" FontWeight="SemiBold" Foreground="#30D158"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- A script or app's live activity, compact -->
                <Grid x:Name="ExternalCompact" Width="190" Height="34">
                    <TextBlock x:Name="ExternalGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#0A84FF"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
                    <TextBlock x:Name="ExternalTitle" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="38,0,52,0"/>
                    <TextBlock x:Name="ExternalSide" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" Typography.NumeralAlignment="Tabular"/>
                    <Border x:Name="ExternalBarTrack" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="16,0,16,3"
                            Background="#33FFFFFF" Visibility="Collapsed">
                        <Border x:Name="ExternalBar" HorizontalAlignment="Left" CornerRadius="1" Background="#0A84FF" Width="0"/>
                    </Border>
                </Grid>

                <!-- Timer, compact -->
                <Grid x:Name="TimerCompact" Width="150" Height="34">
                    <Path Style="{StaticResource ClockMark}" Width="15" Height="15"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
                    <TextBlock x:Name="TimerCompactText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,13,0" FontSize="13" FontWeight="SemiBold" Foreground="#FF9F0A"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Music, expanded -->
                <Grid x:Name="MusicExpanded" Width="372" Height="152">
                    <Grid Margin="20,18,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ExpandedArt" CornerRadius="13" Background="{StaticResource ArtPlaceholder}"/>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TrackArtist" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Canvas x:Name="ExpandedEq" Grid.Column="2" Width="24" Height="20" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeElapsed" Style="{StaticResource Caption}" FontSize="11"
                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="ProgressHit" Grid.Column="1" Background="Transparent" Height="16" Cursor="Hand">
                                <Grid x:Name="ProgressTrack" Height="5" VerticalAlignment="Center">
                                    <Border CornerRadius="2.5" Background="{StaticResource Track}"/>
                                    <Border x:Name="ProgressFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TimeRemaining" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="PreviousButton" Style="{StaticResource ControlButton}" Width="52">
                                <Path Data="{StaticResource SkipGlyph}" Fill="White" Width="23" Height="15" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                                </Path>
                            </Border>
                            <Border x:Name="PlayButton" Style="{StaticResource ControlButton}" Width="60" Margin="18,0">
                                <Path x:Name="PlayGlyphPath" Data="{StaticResource PauseGlyph}" Fill="White" Width="20" Height="22" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="NextButton" Style="{StaticResource ControlButton}" Width="52">
                                <Path Data="{StaticResource SkipGlyph}" Fill="White" Width="23" Height="15" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Timer, expanded: choose a length and start, or pause and stop -->
                <Grid x:Name="TimerExpanded" Width="372" Height="150">
                    <Grid Margin="20,16,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ClockMark}" Width="14" Height="14"/>
                            <TextBlock x:Name="TimerHeader" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BtnMinus" Width="34" Height="34" CornerRadius="17" Background="#FF2C2C2E" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="&#x2212;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <TextBlock x:Name="TimerBig" Grid.Column="1" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="BtnPlus" Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#FF2C2C2E" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="+" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="BtnStart" Width="120" Height="34" CornerRadius="17" Background="#FFFF9F0A" Margin="5,0">
                                <TextBlock x:Name="BtnStartText" Foreground="Black" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnWatch" Width="120" Height="34" CornerRadius="17" Background="#FF2C2C2E" Margin="5,0">
                                <TextBlock x:Name="BtnWatchText" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnPause" Width="120" Height="34" CornerRadius="17" Background="#FF2C2C2E" Margin="5,0">
                                <TextBlock x:Name="BtnPauseText" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnStop" Width="120" Height="34" CornerRadius="17" Background="#FF4A2422" Margin="5,0">
                                <TextBlock x:Name="BtnStopText" Foreground="#FFFF6B61" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Live activities from scripts and apps, expanded -->
                <Grid x:Name="ExternalExpanded" Width="372" Height="150">
                    <StackPanel x:Name="ExternalList" Margin="20,14,20,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- Clock and system, expanded -->
                <Grid x:Name="SystemExpanded" Width="372" Height="150">
                    <Grid Margin="22,16,22,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="132"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockBig" FontSize="44" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="ClockDate" Style="{StaticResource Caption}" FontSize="13" Margin="2,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="CpuLabel" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock x:Name="CpuText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                            <Border Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="0,4,0,12">
                                <Border x:Name="CpuFill" HorizontalAlignment="Left" CornerRadius="2.5" Background="#0A84FF" Width="0"/>
                            </Border>
                            <Grid>
                                <TextBlock x:Name="MemoryLabel" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock x:Name="MemoryText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                            <Border Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="0,4,0,0">
                                <Border x:Name="MemoryFill" HorizontalAlignment="Left" CornerRadius="2.5" Background="#30D158" Width="0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Claude, expanded -->
                <Grid x:Name="ClaudeExpanded" Width="372" Height="156">
                    <Grid Margin="20,18,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Codex, under Claude when it is installed and turned on -->
                        <Grid x:Name="CodexSection" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
                            <Border Height="1" Background="#22FFFFFF" VerticalAlignment="Top"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" VerticalAlignment="Center">
                                    <Image x:Name="ExpandedCodexGlyph" Source="Assets/codex.png" Width="38" Height="38"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Codex" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CodexStatus" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Grid Width="36" Height="36">
                                        <Ellipse Stroke="{StaticResource Track}" StrokeThickness="4"/>
                                        <Path x:Name="CodexSessionArc" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="CodexSessionPercent" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="5h" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Center">
                                    <Grid Width="36" Height="36">
                                        <Ellipse Stroke="{StaticResource Track}" StrokeThickness="4"/>
                                        <Path x:Name="CodexWeeklyArc" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="CodexWeeklyPercent" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="CodexWeeklyLabel" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#29E8875F">
                                <local:ClaudeSpark x:Name="ExpandedSpark" Width="24" Height="24"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ClaudeTitle" Text="Claude Code" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="OpenClaudeLink" FontSize="12" Foreground="#0A84FF" Cursor="Hand" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="UsageRow" Grid.Row="1" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48" Height="48">
                                    <Ellipse Stroke="{StaticResource Track}" StrokeThickness="5" Margin="0"/>
                                    <Path x:Name="SessionArc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="SessionPercent" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SessionLabel" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="SessionReset" FontSize="13" FontWeight="Medium" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Grid Width="48" Height="48">
                                    <Ellipse Stroke="{StaticResource Track}" StrokeThickness="5"/>
                                    <Path x:Name="WeeklyArc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock x:Name="WeeklyPercent" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WeeklyLabel" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="WeeklyReset" FontSize="13" FontWeight="Medium" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="NoUsageText" Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   TextTrimming="None" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <!-- A very small note, such as for a screenshot -->
                <Grid x:Name="Toast" Width="184" Height="36">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ToastText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="136" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Volume or brightness while it changes -->
                <Grid x:Name="Level" Width="220" Height="36">
                    <TextBlock x:Name="LevelGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Border Height="6" CornerRadius="3" Background="#40FFFFFF" VerticalAlignment="Center" Margin="42,0,52,0">
                        <Border x:Name="LevelFill" HorizontalAlignment="Left" CornerRadius="3" Background="White" Width="0"/>
                    </Border>
                    <TextBlock x:Name="LevelText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,14,0" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Alert banner: Claude alerts and Windows notifications -->
                <Grid x:Name="Banner" Width="352" Height="74">
                    <Viewbox Stretch="Uniform"><Grid Width="352" Height="74">
                    <Grid Margin="16,0,22,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BannerIcon" Width="42" Height="42" CornerRadius="21" Background="#29E8875F">
                            <Grid>
                                <local:ClaudeSpark x:Name="BannerSpark" Width="26" Height="26"/>
                                <Path x:Name="BannerBell" Data="{StaticResource BellGlyph}" Fill="White" Width="18" Height="19"
                                      Stretch="Uniform" Visibility="Collapsed"/>
                                <TextBlock x:Name="BannerGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Image x:Name="BannerCodex" Source="Assets/codex.png" Width="30" Height="30" Visibility="Collapsed"/>
                                <Image x:Name="BannerAppIcon" Width="30" Height="30" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BannerApp" Style="{StaticResource Caption}" FontSize="11" Visibility="Collapsed"/>
                            <TextBlock x:Name="BannerTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="BannerSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,1,0,0"/>
                        </StackPanel>
                        <!-- A big value on the right, such as the battery percentage -->
                        <TextBlock x:Name="BannerSide" Grid.Column="2" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="12,0,2,0" Typography.NumeralAlignment="Tabular" Visibility="Collapsed"/>
                    </Grid>
                
                    </Grid></Viewbox>
                </Grid>
                <!-- A permission Claude Code asks for, with Allow and Deny -->
                <Grid x:Name="PermissionPanel" Width="372" Height="138">
                    <Grid Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PermIconBack" Width="30" Height="30" CornerRadius="15" Background="#33FF9F0A">
                                <Grid>
                                    <TextBlock x:Name="PermLock" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#FF9F0A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- The Supabase mark, for tools of the Supabase connector -->
                                    <Path x:Name="PermSupabase" Width="15" Height="15" Stretch="Uniform" Fill="#FF3ECF8E" Visibility="Collapsed"
                                          Data="M11.9 1.036c-.015-.986-1.26-1.41-1.874-.637L.764 12.05C-.33 13.427.65 15.455 2.409 15.455h9.579l.113 7.51c.014.985 1.259 1.408 1.873.636l9.262-11.653c1.093-1.375.113-3.403-1.645-3.403h-9.642z"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PermTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PermTool" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="PermQueue" Grid.Column="2" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,8" Padding="9,6" CornerRadius="9" Background="#1FFFFFFF">
                            <TextBlock x:Name="PermSummary" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#E6FFFFFF" MaxHeight="34"/>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PermCheck" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="PermDeny" Grid.Column="1" CornerRadius="13" Padding="13,5,15,5" Background="#FFFF453A" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PermDenyText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PermOpen" Grid.Column="2" CornerRadius="13" Padding="14,5" Background="#FF0A84FF" Cursor="Hand" Visibility="Collapsed">
                                <TextBlock x:Name="PermOpenText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <Border x:Name="PermAllow" Grid.Column="2" CornerRadius="13" Padding="13,5,15,5" Background="#FF30D158" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PermAllowText" FontSize="13" FontWeight="SemiBold" Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- Which page is open, when there is more than one -->
                <StackPanel x:Name="PageDots" Orientation="Horizontal" Visibility="Collapsed" Background="Transparent"/>
            </Canvas>
        </Border>
    </Grid>
</Window>
